---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  /dist/
  /tests/output/
  .venv/
  # Generated by antsibull-changelog, which owns their formatting. Hand-editing
  # them to satisfy yamllint would be undone by the next `antsibull-changelog
  # release`, and `antsibull-changelog lint` is the correct validator for the
  # fragments that feed them.
  /changelogs/.plugin-cache.yaml
  /changelogs/changelog.yaml
